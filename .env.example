# Cloudflare Web Analytics — token z dashboardu (Analytics & Logs > Web Analytics)
# Skopírovať do .env.local pred `npm run build` / `npm run deploy`
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=CF_ANALYTICS_TOKEN

# Resend API kľúč pre kontaktný formulár — nastavuje sa ako Cloudflare secret:
# npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=RESEND_API_KEY
